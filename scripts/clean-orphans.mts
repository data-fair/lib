// Remove the build outputs whose source was deleted: tsc never does it and npm publish would ship them.
import { globSync, existsSync, rmSync } from 'node:fs'
import path from 'node:path'
import { execFileSync } from 'node:child_process'

const tracked = new Set(execFileSync('git', ['ls-files', 'packages'], { encoding: 'utf8' }).split('\n'))

for (const file of globSync('packages/**/*.{js,js.map,d.ts}')) {
  if (file.includes('node_modules') || file.includes('.type/') || tracked.has(file)) continue
  const base = file.replace(/\.(js\.map|js|d\.ts)$/, '')
  if (existsSync(base + '.ts') || (base.endsWith('.vue') && existsSync(base))) continue
  // index generated by df-build-types next to a schema
  if (path.basename(base) === 'index' && existsSync(path.join(path.dirname(file), 'schema.json'))) continue
  console.log('remove orphan build output', file)
  if (!process.argv.includes('--dry-run')) rmSync(file)
}
